//
//  Config.swift
//  Generated by Servbiz from your settings. Safe to edit, but the next build
//  from the dashboard will overwrite it -- change things there instead.
//
//  Compiled constants rather than a bundled config.json.
//
//  Two reasons. The values are known at build time and never change at runtime,
//  so parsing JSON on launch would be work done to recover something the compiler
//  already knew. And the allow-list below is the shell's security boundary: as
//  source it cannot be edited inside a signed app, whereas a JSON file in the
//  bundle is a file, and repointing an app at an attacker's page should not be a
//  matter of replacing one.
//

import UIKit

enum AppConfig {

    // MARK: - Destination

    /// Force-unwrapped deliberately. The URL is validated by the API before the
    /// build is queued and again by the worker before this file is written, so a
    /// failure here means the generator is broken -- and crashing at launch is a
    /// far better way to find that out than shipping an app that opens nothing.
    static let startURL = URL(string: "{{START_URL}}")!

    /// Hosts this app will render. Everything else is refused or handed to Safari.
    static let allowedHosts: [String] = [{{ALLOWED_HOSTS}}]

    static let externalLinksInBrowser = {{EXTERNAL_LINKS_IN_BROWSER}}

    /// Whether a URL may be shown inside the app.
    ///
    /// Subdomain matching is on a dot boundary, not `hasSuffix`. Plain
    /// `hasSuffix("example.com")` also matches `notexample.com`, which an attacker
    /// can simply register.
    static func isAllowedHost(_ url: URL) -> Bool {
        guard let host = url.host?.lowercased() else { return false }
        return allowedHosts.contains { allowed in
            host == allowed || host.hasSuffix("." + allowed)
        }
    }

    // MARK: - Appearance

    static let themeColor = UIColor(hex: "{{THEME_COLOR}}")
    static let backgroundColor = UIColor(hex: "{{BACKGROUND_COLOR}}")
    static let splashColor = UIColor(hex: "{{SPLASH_COLOR}}")
    static let showLogo = {{SHOW_LOGO}}

    /// Seconds before the launch cover is removed regardless of load state.
    static let splashMaxWait: TimeInterval = {{SPLASH_MAX_WAIT}}

    static let statusBarStyle: UIStatusBarStyle = {{STATUS_BAR_STYLE}}
    static let hideStatusBar = {{HIDE_STATUS_BAR}}
    static let respectSafeArea = {{RESPECT_SAFE_AREA}}
    static let orientationMask: UIInterfaceOrientationMask = {{ORIENTATION_MASK}}

    // MARK: - Behaviour

    static let pullToRefresh = {{PULL_TO_REFRESH}}
    static let swipeNavigation = {{SWIPE_NAVIGATION}}
    static let inlineMedia = {{INLINE_MEDIA}}
    static let allowsLinkPreview = {{ALLOWS_LINK_PREVIEW}}
    static let keepScreenOn = {{KEEP_SCREEN_ON}}
}

extension UIColor {
    /// #RRGGBB to UIColor. The generator only ever emits that form.
    convenience init(hex: String) {
        let cleaned = hex.hasPrefix("#") ? String(hex.dropFirst()) : hex
        var value: UInt64 = 0
        Scanner(string: cleaned).scanHexInt64(&value)
        self.init(
            red: CGFloat((value & 0xFF0000) >> 16) / 255,
            green: CGFloat((value & 0x00FF00) >> 8) / 255,
            blue: CGFloat(value & 0x0000FF) / 255,
            alpha: 1
        )
    }
}
