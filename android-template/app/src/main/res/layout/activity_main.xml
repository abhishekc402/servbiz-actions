<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      Inset padding is applied to this layer, not to the root, so the two scrims
      below can paint the strips behind the system bars in different colours. When
      the root itself was padded there was only ever one background colour, which
      is why the status and navigation bars could not be themed separately.
    -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/webview_desc" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!--
      In-app splash. Covers the WebView until the page paints, so users never see
      a white flash or a half-rendered site. Background colour and logo visibility
      come from config.json at runtime, which keeps them on the fast-patch path.
      importantForAccessibility=no so TalkBack does not announce a decorative view.
    -->
    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:clickable="false"
        android:focusable="false">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:contentDescription="@string/splash_logo_desc"
            android:src="@mipmap/ic_launcher" />

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="72dp"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!--
      Strips painted behind the system bars. Needed because targetSdk 35 forces
      edge-to-edge on Android 15+, where window.statusBarColor and
      window.navigationBarColor are ignored: the only way to colour those areas is
      to draw something under them.

      Last in the file so they sit above the WebView and the splash. Heights are
      zero here and set from the real insets at runtime, because a hardcoded
      24dp/48dp would be wrong on any device with a different bar size, a notch,
      or gesture navigation.
    -->
    <View
        android:id="@+id/statusScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/navScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:importantForAccessibility="no" />
</FrameLayout>
