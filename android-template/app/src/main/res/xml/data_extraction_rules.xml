<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
      Backup is disabled in the manifest. These rules exist so that if it is ever
      enabled, WebView cookies and cached credentials are excluded by default
      rather than swept into a cloud backup.
    -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
