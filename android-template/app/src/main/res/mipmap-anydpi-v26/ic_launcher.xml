<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon, API 26+.

  The foreground is a PNG on purpose. A vector foreground would be compiled into
  resources and could only be changed by a full rebuild; a PNG per density stays
  swappable by the fast-patch path, so a user changing their icon does not need a
  Gradle run.

  The background is a colour generated by build.gradle.kts from the
  -Pservbiz.iconBackgroundColor property, which makes it rebuild-tier. If you need
  the background to be patchable too, point it at a PNG drawable instead.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
